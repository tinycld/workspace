# Workspace members that are their own git repos (cloned as siblings).
# The outer ./new repo is just scratch scaffolding (workspace root); each
# member carries its own history + remote (and its own .gitignore for generated
# artifacts), so don't track their contents here.

# Root scaffolding now OWNED by @tinycld/bootstrap (laid down by
# `bootstrap --tooling` from templates/workspace/). Present on disk for the
# generator + vitest, but no longer committed here — bootstrap is the source.
/tinycld.packages.ts
/vitest.config.ts
/tests/
# Root biome config — written by the generator (every install) and bootstrap.
# A minimal `root: true` config that extends tinycld/biome.json so biome is
# resolvable from inside any member. Not committed; regenerated on install.
/biome.json
.claude
.env*
notes.txt
.watchman*
# Google Play submit credential (service-account JSON) — referenced by
# tinycld/eas.json submit.production.android.serviceAccountKeyPath. Never commit.
google-play-service-account.json

# Root generated artifacts (regenerated by the generator / link-members on every
# install) and local scratch — present on disk but never committed to this repo.
/core/
/scripts/
/app.json
# One-off debugging screenshots + working notes.
*.png
