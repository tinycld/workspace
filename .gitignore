*.tsbuildinfo
.DS_Store

# Generated app wiring (regenerated by app/scripts/generate.ts)
app/lib/generated/
app/tinycld.config.ts
app/tinycld.seeds.ts
# Generated per-package route dirs under [orgSlug] (contacts/, mail/, …). The
# trailing /*/ ignores subdirs; app-owned subdirs are negated below.
app/app/a/\[orgSlug\]/*/
# App-owned (hand-written) route files/dirs under [orgSlug] — keep tracked.
!app/app/a/\[orgSlug\]/settings/
# Generated public route re-exports under share/ (e.g. [token].tsx from drive).
# The hand-written share/_layout.tsx is kept tracked (negated).
app/app/share/*
!app/app/share/_layout.tsx
app/server/package_extensions.go
app/server/go.work
app/server/go.work.sum
app/server/pb_migrations/
app/server/pb_hooks/
app/server/pb_data/
app/server/pb_test_data/
app/server/app
app/dist/

# Playwright
playwright-report/
test-results/
app/tmp/

# Spike scratch
spike2/

# Workspace members that are their own git repos (cloned as siblings).
# The outer ./new repo is just scratch scaffolding (workspace root); each
# member carries its own history + remote, so don't track their contents here.
/core/
/contacts/
/mail/
/calendar/
/drive/
/calc/
/text/
/google-takeout-import/
