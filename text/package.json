{
    "name": "@tinycld/text",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Plain-text and rich-text documents.",
    "exports": {
        "./package.json": "./package.json",
        "./manifest": "./manifest.ts",
        "./types": "./tinycld/text/types.ts",
        "./collections": "./tinycld/text/collections.ts",
        "./screens/*": "./tinycld/text/screens/*.tsx",
        "./provider": "./tinycld/text/provider.tsx",
        "./hooks/*": "./tinycld/text/hooks/*.ts",
        "./components/*": "./tinycld/text/components/*.tsx",
        "./seed": "./tinycld/text/seed.ts"
    },
    "scripts": {
        "typecheck": "tinycld-pkg typecheck",
        "test": "tinycld-pkg test",
        "test:e2e": "tinycld-pkg test:e2e",
        "check": "tinycld-pkg check"
    },
    "devDependencies": {
        "@tinycld/package-scripts": "*"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-native": ">=0.83",
        "expo-router": ">=55.0.0",
        "lucide-react-native": ">=0.400.0",
        "pbtsdb": ">=0.5",
        "@tanstack/react-db": ">=0.1",
        "@tanstack/db": ">=0.6"
    }
}
