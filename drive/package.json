        "check": "tinycld-pkg check"
    },
    "devDependencies": {
        "@tinycld/package-scripts": "*"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-native": ">=0.83",
        "expo-router": ">=55.0.0",
        "pbtsdb": ">=0.5",
